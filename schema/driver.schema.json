{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CameronChambers93/lumix-lux-core/schema/driver.schema.json",
  "title": "Lumix Lux camera driver",
  "description": "One file in drivers/. Data only. A model file 'extends' a family base and lists only what differs; the runtimes deep-merge it onto the base. Both runtimes validate with the subset of JSON Schema used here (type, required, properties, additionalProperties, pattern, enum, items, minimum, minItems, $ref to $defs).",
  "type": "object",
  "required": ["id", "schema", "version", "name"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "schema": { "type": "integer", "enum": [1] },
    "version": { "type": "integer", "minimum": 1 },
    "extends": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "protocol": { "type": "string", "enum": ["panasonic-camcgi"] },
    "abstract": { "type": "boolean" },
    "name": { "type": "string" },
    "label": { "type": "string" },
    "appIdPrefix": { "type": "string", "pattern": "^[0-9A-F-]+$" },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelNumber": { "type": "string" },
        "friendlyName": { "type": "string" },
        "capabilityModel": { "type": "string" }
      }
    },
    "hotspot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ip": { "$ref": "#/$defs/ipv4" },
        "ssidPrefix": { "type": "string" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "$ref": "#/$defs/port" },
        "path": { "$ref": "#/$defs/path" },
        "busy": { "type": "string" },
        "busyStatus": { "type": "integer" },
        "probe": {
          "type": "object", "additionalProperties": false,
          "properties": { "query": { "$ref": "#/$defs/query" }, "match": { "type": "string" } }
        },
        "pair": {
          "type": "object", "additionalProperties": false,
          "properties": { "query": { "$ref": "#/$defs/query" }, "okPrefix": { "type": "string" }, "timeoutMs": { "$ref": "#/$defs/ms" } }
        },
        "state": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "query": { "$ref": "#/$defs/query" }, "resultTag": { "$ref": "#/$defs/tag" }, "okValue": { "type": "string" },
            "batteryTag": { "$ref": "#/$defs/tag" }, "modeTag": { "$ref": "#/$defs/tag" }
          }
        },
        "capability": {
          "type": "object", "additionalProperties": false,
          "properties": { "query": { "$ref": "#/$defs/query" }, "modelTag": { "$ref": "#/$defs/tag" } }
        },
        "modes": {
          "type": "object", "additionalProperties": false,
          "properties": { "media": { "$ref": "#/$defs/mode" }, "rec": { "$ref": "#/$defs/mode" } }
        },
        "settleMs": { "$ref": "#/$defs/ms" },
        "keepaliveMs": { "$ref": "#/$defs/ms" },
        "timeoutMs": { "$ref": "#/$defs/ms" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": { "type": "string", "enum": ["upnp-cds"] },
        "controlPort": { "$ref": "#/$defs/port" },
        "controlPath": { "$ref": "#/$defs/path" },
        "objectId": { "type": "string" },
        "pageSize": { "type": "integer", "minimum": 1 },
        "retryCounts": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
        "resourceProfile": { "type": "string" },
        "roles": {
          "type": "object", "required": ["orig"], "additionalProperties": false,
          "properties": { "orig": { "type": "string" }, "thumb": { "type": "string" }, "preview": { "type": "string" } }
        },
        "idPattern": { "type": "string" },
        "nameTemplate": { "type": "string" },
        "dateHeader": { "type": "string" },
        "dateFrom": { "type": "string", "enum": ["thumb", "preview", "orig"] },
        "range": { "type": "boolean" },
        "slots": { "type": "integer", "minimum": 1 }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ssdp": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "port": { "$ref": "#/$defs/port" }, "target": { "type": "string" }, "cdsTarget": { "type": "string" },
            "replyContains": { "type": "array", "items": { "type": "string" } }
          }
        },
        "busyPort": { "$ref": "#/$defs/port" },
        "info": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "nameTag": { "$ref": "#/$defs/tag" }, "modelTag": { "$ref": "#/$defs/tag" },
            "firmwareTag": { "$ref": "#/$defs/tag" }, "manufacturerTag": { "$ref": "#/$defs/tag" }
          }
        }
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liveView": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "port": { "$ref": "#/$defs/port" }, "start": { "$ref": "#/$defs/query" }, "stop": { "$ref": "#/$defs/query" },
            "jpegScan": { "type": "boolean" }
          }
        },
        "commands": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "capture": { "$ref": "#/$defs/query" }, "videoStart": { "$ref": "#/$defs/query" }, "videoStop": { "$ref": "#/$defs/query" },
            "zoomWide": { "$ref": "#/$defs/query" }, "zoomTele": { "$ref": "#/$defs/query" }, "zoomStop": { "$ref": "#/$defs/query" },
            "focus": { "$ref": "#/$defs/query" }
          }
        },
        "focusScale": { "type": "integer", "minimum": 1 }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remote": { "type": "boolean" },
        "liveView": { "type": "boolean" },
        "video": { "type": "boolean" },
        "touchFocus": { "type": "boolean" },
        "zoom": { "type": "string", "enum": ["none", "normal"] },
        "dates": { "type": "string", "enum": ["header", "exif", "none"] },
        "range": { "type": "boolean" },
        "gps": { "type": "string", "enum": ["none", "phone"] }
      }
    },
    "verified": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firmware": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\d$" },
        "by": { "type": "string" }
      }
    }
  },
  "$defs": {
    "port": { "type": "integer", "minimum": 1 },
    "ms": { "type": "integer", "minimum": 0 },
    "path": { "type": "string", "pattern": "^/" },
    "tag": { "type": "string", "pattern": "^[A-Za-z_][\\w.-]*$" },
    "ipv4": { "type": "string", "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}$" },
    "query": { "type": "string", "pattern": "^[^?#\\s]+$" },
    "mode": {
      "type": "object", "required": ["value", "query"], "additionalProperties": false,
      "properties": { "value": { "type": "string" }, "query": { "$ref": "#/$defs/query" } }
    }
  }
}
