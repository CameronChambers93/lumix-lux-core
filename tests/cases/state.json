[
 {
  "name": "ok in play mode",
  "fn": "parseState",
  "driver": "panasonic-zs100",
  "args": [
   "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n<camrply><result>ok</result><state><batt>2/3</batt><cammode>play</cammode><sdcardstatus>write_enable</sdcardstatus><sd_memory>set</sd_memory><sd_access>off</sd_access><version>1.6</version><add_location_data>off</add_location_data></state></camrply>"
  ],
  "expect": {
   "result": "ok",
   "ok": true,
   "busy": false,
   "battery": "2/3",
   "mode": "play"
  }
 },
 {
  "name": "rec mode, with the rec-only fields",
  "fn": "parseState",
  "driver": "panasonic-zs100",
  "args": [
   "<camrply><result>ok</result><state><batt>3/3</batt><cammode>rec</cammode><remaincapacity>1520</remaincapacity><temperature>normal</temperature></state></camrply>"
  ],
  "expect": {
   "ok": true,
   "mode": "rec",
   "state": {
    "batt": "3/3",
    "cammode": "rec",
    "remaincapacity": "1520",
    "temperature": "normal"
   }
  }
 },
 {
  "name": "busy",
  "fn": "parseState",
  "driver": "panasonic-zs100",
  "args": [
   "<camrply><result>err_already_connected</result></camrply>"
  ],
  "expect": {
   "result": "err_already_connected",
   "ok": false,
   "busy": true,
   "battery": null,
   "mode": null,
   "state": {}
  }
 },
 {
  "name": "not paired yet",
  "fn": "parseState",
  "driver": "panasonic-zs100",
  "args": [
   "<camrply><result>err_unsuitable_app</result></camrply>"
  ],
  "expect": {
   "ok": false,
   "busy": false
  }
 },
 {
  "name": "capability model",
  "fn": "parseCapability",
  "driver": "panasonic-zs100",
  "args": [
   "<?xml version=\"1.0\"?><camrply><result>ok</result><comm_proto_ver>1.6</comm_proto_ver><product_info><model>TZ100</model></product_info><camcmd_list><camcmd>tele-normal</camcmd></camcmd_list></camrply>"
  ],
  "expect": {
   "model": "TZ100"
  }
 }
]
