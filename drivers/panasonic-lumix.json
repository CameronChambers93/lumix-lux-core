{
  "id": "panasonic-lumix",
  "name": "Panasonic Lumix (Wi-Fi, cam.cgi + UPnP)",
  "protocol": "camcgi-upnp",
  "label": "Lumix camera",
  "model": "ZS100",
  "defaultIp": "10.0.0.220",
  "waitingHint": "Is it on the Wi-Fi waiting screen?",
  "appIdPrefix": "4D454930-0100-1000-",

  "hotspot": {
    "ip": "192.168.54.1",
    "subnet": "192.168.54.",
    "ssidPrefix": "ZS100-"
  },

  "control": {
    "port": 80,
    "path": "/cam.cgi",
    "busy": "err_already_connected",
    "probe": { "query": "mode=getstate", "match": "<camrply" },
    "pair": "mode=accctrl&type=req_acc&value={appId}&value2={appName}",
    "state": {
      "query": "mode=getstate",
      "element": "state",
      "resultTag": "result",
      "okValue": "ok",
      "batteryTag": "batt",
      "modeTag": "cammode",
      "playValue": "play",
      "recValue": "rec"
    },
    "playMode": "mode=camcmd&value=playmode",
    "recMode": "mode=camcmd&value=recmode",
    "settleMs": 2000
  },

  "media": {
    "protocol": "upnp-cds",
    "controlUrl": "http://{ip}:60606/Server0/CDS_control",
    "pageSize": 50,
    "resourceProfile": "PANASONIC\\.COM_PN=(\\w+)",
    "roles": { "orig": "CAM_ORG", "thumb": "CAM_TN", "preview": "CAM_LRGTN" },
    "idPattern": "^\\d+$",
    "nameTemplate": "P{id}.{ext}",
    "filePattern": "^P(\\d+)\\.(JPG|MP4)$",
    "contentTypes": { "JPG": "image/jpeg", "MP4": "video/mp4" },
    "dateHeader": "X-REC_DATE_TIME",
    "slots": 2
  },

  "discovery": {
    "ssdp": {
      "port": 1900,
      "target": "urn:schemas-upnp-org:device:MediaServer:1",
      "locationPort": 60606,
      "serverContains": "panasonic"
    },
    "busyPort": 60606
  },

  "info": { "nameTag": "friendlyName", "modelTag": "modelNumber", "firmwareTag": "X_FirmVersion" },

  "remote": {
    "liveView": {
      "port": 49199,
      "start": "mode=startstream&value={port}",
      "stop": "mode=stopstream"
    },
    "reply": { "resultTag": "result", "okValue": "ok" },
    "commands": {
      "capture": "mode=camcmd&value=capture",
      "videoStart": "mode=camcmd&value=video_recstart",
      "videoStop": "mode=camcmd&value=video_recstop",
      "zoomWide": "mode=camcmd&value=wide-normal",
      "zoomTele": "mode=camcmd&value=tele-normal",
      "zoomStop": "mode=camcmd&value=zoomstop",
      "focus": "mode=camctrl&type=touch&value={x}/{y}&value2=on"
    },
    "focusScale": 1000
  }
}
